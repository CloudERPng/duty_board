 "fields": [
  {
   "fieldname": "title",
   "fieldtype": "Data",
   "label": "Task",
   "reqd": 1,
   "in_list_view": 1,
   "description": "What the task will be called each time. A date is added automatically where the frequency makes one useful."
  },
  {
   "fieldname": "project",
   "fieldtype": "Link",
   "options": "Duty Project",
   "label": "Project",
   "reqd": 1
