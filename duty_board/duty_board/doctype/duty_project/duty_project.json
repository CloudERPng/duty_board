   "fieldname": "baseline_target_date",
   "fieldtype": "Date",
   "label": "Baseline Go-Live",
   "description": "The go-live date originally committed to. Never edit it once set: the whole point is that it does not move, so slip can be measured against something real. target_date is the current expectation and may move."
  },
  {
   "fieldname": "rag",
   "fieldtype": "Select",
   "label": "Status (RAG)",
   "options": "On track\nAt risk\nOff track\nCompleted",
   "description": "Set deliberately. Left empty it means nobody has said, and the header falls back to the evidence and says so \u2014 which is honest. A default of 'On track' made every project born green and indistinguishable from one somebody had actually judged."
  },
  {
   "fieldname": "rag_reason",
   "fieldtype": "Small Text",
   "label": "Why",
   "depends_on": "eval:['At risk','Off track'].includes(doc.rag)",
   "description": "Required whenever the status is not green. A RAG without a stated reason is decoration, and it is the first thing a reviewer asks about."
  },
